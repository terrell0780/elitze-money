# ---------------------------------------------------------------------------
# Elitze Money Engine — environment configuration
# Copy to `.env` and fill in values. Every setting is optional with a safe
# local default, so the engine runs end-to-end out of the box.
# ---------------------------------------------------------------------------

# Runtime environment: dev | test | prod
ELITZE_ENV=dev

# --- Storage ---------------------------------------------------------------
# Unset -> a local SQLite file under ELITZE_DATA_DIR. Point at PostgreSQL for
# production truth.
# ELITZE_DATABASE_URL=sqlite:///./data/elitze.db
# Example Postgres:
# ELITZE_DATABASE_URL=postgresql+psycopg://elitze:elitze@localhost:5432/elitze

# Qdrant semantic memory. Leave unset to use an embedded local instance.
# ELITZE_QDRANT_URL=http://localhost:6333
ELITZE_QDRANT_COLLECTION=elitze_memory

# --- Model inference (NVIDIA NIM) -----------------------------------------
# ELITZE_NIM_API_KEY=nvapi-xxxxxxxx
ELITZE_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
ELITZE_NIM_MODEL=meta/llama-3.3-70b-instruct
# auto = use NIM when a key is present, otherwise the deterministic offline
# (dry) planner. Explicitly set "dry" to never call the network.
ELITZE_LLM_BACKEND=auto

# --- Safety / policy -------------------------------------------------------
ELITZE_MAX_EXPERIMENT_BUDGET=5000.00
ELITZE_MAX_DAILY_BUDGET=10000.00
ELITZE_DEFAULT_CURRENCY=USD

# --- Revenue ingestion (verified webhooks) ---------------------------------
# Shared secret used to verify revenue webhooks with an HMAC signature.
# Revenue is NEVER recorded without a verified source. Leave unset in dev.
# ELITZE_WEBHOOK_SECRET=change-me

# --- Serving -----------------------------------------------------------------
ELITZE_API_HOST=0.0.0.0
ELITZE_API_PORT=8000

# --- Directories -------------------------------------------------------------
ELITZE_DATA_DIR=./data
ELITZE_VAULT_DIR=./vault

# --- Orchestration ------------------------------------------------------------
ELITZE_MAX_ITERATIONS=3
